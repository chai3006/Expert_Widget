{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expert:contracts:SourceHealth:1",
  "title": "SourceHealth",
  "description": "Result of each news provider's last Refresh.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "working", "total", "providers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "working": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "layer", "status", "checkedAt", "itemCount", "detail", "needsAttention"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "layer": { "enum": [1, 2, 3] },
          "status": { "enum": ["ok", "empty", "failed", "unchecked"] },
          "checkedAt": { "type": ["integer", "null"] },
          "itemCount": { "type": "integer", "minimum": 0 },
          "detail": { "type": ["string", "null"] },
          "needsAttention": { "type": "boolean" }
        }
      }
    }
  }
}
