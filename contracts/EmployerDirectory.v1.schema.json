{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expert:contracts:EmployerDirectory:1",
  "title": "EmployerDirectory",
  "description": "Career pages of companies in Germany for one domain (data/employers/<domain>.json). Only companies with status \"verified\" are shown in the app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domain", "segments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domain": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "label", "companies"],
        "properties": {
          "tier": {
            "description": "top: market leaders. tier1/tier2: direct suppliers and their suppliers, or the field's equivalent. service: consultancies, service and staffing providers. sme: small and medium firms. startup: young companies.",
            "enum": ["top", "tier1", "tier2", "service", "sme", "startup"]
          },
          "label": { "$ref": "#/$defs/text" },
          "companies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "website", "careerUrl", "status", "confidence", "lastVerified", "generatedBy", "sources"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "website": { "type": "string", "pattern": "^https?://" },
                "careerUrl": { "type": "string", "pattern": "^https?://" },
                "status": { "enum": ["proposed", "verified"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "lastVerified": { "type": "string", "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$" },
                "generatedBy": { "type": "string", "minLength": 1, "description": "e.g. \"manual\" or \"claude-sonnet-5-5 via tools/company-directory\"." },
                "sources": { "type": "array", "items": { "type": "string" }, "description": "What confirmed the company, e.g. \"http-check 2026-10-22\", \"gdelt-mention\"." },
                "checks": {
                  "type": "object",
                  "description": "Result of the last verification run (written by tools/company-directory).",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "en"],
      "properties": { "de": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    }
  }
}
