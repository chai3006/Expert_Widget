{
  "name": "expert-widget",
  "productName": "Expert Widget",
  "version": "0.1.0",
  "description": "Desktop widget for Windows, macOS and Linux: CV-driven employer list and engineering hiring news for Germany",
  "private": true,
  "main": "dist/apps/desktop/src/main.js",
  "author": "Venkata Chirravuri",
  "license": "UNLICENSED",
  "scripts": {
    "compile": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs && node scripts/get-translation-model.mjs",
    "dev": "npm run compile && electron . --dev",
    "dev:mock": "npm run compile && electron . --mock --dev",
    "start": "npm run compile && electron .",
    "build": "npm run compile && electron-builder",
    "build:win": "npm run compile && electron-builder --win",
    "build:mac": "npm run compile && electron-builder --mac",
    "build:linux": "npm run compile && electron-builder --linux",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check-links": "node scripts/check-links.mjs",
    "check-sources": "npm run compile && node scripts/check-sources.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cli": "node dist/packages/cli/src/cli.js"
  },
  "build": {
    "appId": "de.expertwidget.app",
    "productName": "Expert Widget",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "data/**/*",
      "defaults/**/*",
      "assets/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "asarUnpack": [
      "dist/packages/node/src/translate/**",
      "node_modules/@browsermt/bergamot-translator/worker/**",
      "assets/translation/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Expert",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Venkata Chirravuri",
      "executableArgs": [
        "--ozone-platform=x11"
      ]
    }
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "0.4.9",
    "cheerio": "^1.2.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "bin": {
    "expert-cli": "dist/packages/cli/src/cli.js"
  }
}
